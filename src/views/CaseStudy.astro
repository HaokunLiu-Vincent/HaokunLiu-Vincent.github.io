---
import Layout from '@/layouts/Layout.astro';
import site from '@/config/site.json';
import { dictionaries, route } from '@/i18n';
import type { Locale, ProjectContent } from '@/i18n/types';
import Architecture from '@/components/Architecture.astro';
import Arrow from '@/components/Arrow.astro';
import ContactCTA from '@/components/ContactCTA.astro';
interface Props { locale: Locale; project: ProjectContent }
const { locale, project: p } = Astro.props;
const t = dictionaries[locale];
const repository = site.projectRepositories[p.id] as string | null;
---
<Layout locale={locale} page={p.page}>
  <article data-project={p.id}>
    <header class="case-intro shell"><a class="text-link back-link" href={route(locale, 'projects')}><Arrow direction="left" />{t.common.backProjects}</a><p class="eyebrow">{p.number} / {p.category}</p><h1>{p.name}</h1><p class="lead">{p.summary}</p><ul class="tag-list">{p.tags.map(tag => <li>{tag}</li>)}</ul><div class="case-actions"><p class="project-status"><span></span>{p.status}</p>{repository ? <a class="text-link" href={repository}>{t.common.github}<Arrow direction="up-right" /></a> : <span class="small-note">{t.common.repositoryPending}</span>}</div></header>
    <div class="shell">
      <aside class="evidence-note"><span class="evidence-mark" aria-hidden="true">i</span><p>{p.evidenceNote}</p></aside>
      <section class="editorial-row"><h2 class="section-label">{p.overview}</h2><div><p class="body-copy">{p.overviewText}</p>{p.description.map(paragraph => <p class="body-copy mt-5">{paragraph}</p>)}<ul class="scope-list">{p.scope.map(item => <li>{item}</li>)}</ul></div></section>
      <section class="case-architecture"><p class="eyebrow">01 / {p.labels.architecture}</p><h2>{p.architecture}</h2><p class="body-copy">{p.architectureNote}</p><Architecture project={p} /></section>
      <section class="case-section"><div class="case-section-heading"><p class="eyebrow">02 / {p.labels.methods}</p><h2>{p.methods}</h2><p class="body-copy">{p.methodsIntro}</p></div><div class="method-list">{p.methodItems.map((method, i) => <section class="method-item"><span class="index-number">0{i + 1}</span><div><h3>{method.title}</h3><p class="body-copy">{method.description}</p><p class="method-detail">{method.detail}</p></div></section>)}</div></section>
      <section class="case-section"><div class="case-section-heading"><p class="eyebrow">03 / {p.labels.evaluation}</p><h2>{p.evaluation}</h2><p class="body-copy">{p.evaluationIntro}</p></div><div class="table-wrap"><table><caption class="sr-only">{p.evaluationIntro}</caption><thead><tr><th scope="col">{p.metric}</th><th scope="col">{p.purpose}</th><th scope="col">{p.result}</th></tr></thead><tbody>{p.metrics.map(metric => <tr><th scope="row">{metric.name}</th><td>{metric.purpose}</td><td><span class="result-pending">{metric.result}</span></td></tr>)}</tbody></table></div><div class="protocol-note"><h3>{p.protocolTitle}</h3><p>{p.protocol}</p></div></section>
      <section class="editorial-row deployment-row"><div><p class="eyebrow">04 / {p.labels.deployment}</p><h2>{p.deployment}</h2></div><div><p class="body-copy">{p.deploymentText}</p><ul class="scope-list">{p.deploymentItems.map(item => <li>{item}</li>)}</ul></div></section>
      <section class="next-section"><div><h2>{p.nextTitle}</h2><p class="body-copy">{p.nextText}</p></div><ol>{p.nextItems.map(item => <li>{item}</li>)}</ol></section>
    </div>
  </article>
  <ContactCTA locale={locale} />
</Layout>
